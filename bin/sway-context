#!/usr/bin/env -S mise exec -- ruby
# frozen_string_literal: true

# sway-context: named "contexts" spanning all work outputs in sway + swaysome.
#
# A context is a swaysome slot N (0..9) with a name. On every work output
# (every active output that is not an ambient output) the workspace with
# number <group>N is renamed to "<group>N:<name>", so the name shows up in
# the bar and survives as long as the workspace has windows. A small state
# file remembers names for slots whose workspaces are currently empty.
#
# A context may belong to a project (matched by regexp on its name). The
# project provides variables, environment, a working directory and actions
# (commands to launch in the context); see DEFAULT_CONFIG.

require "json"
require "open3"
require "fileutils"
require "shellwords"

module SwayContext
  CONFIG_PATH = File.expand_path(ENV.fetch("SWAY_CONTEXT_CONFIG", "~/.config/sway-context/config.json"))
  STATE_PATH  = File.expand_path(ENV.fetch("SWAY_CONTEXT_STATE", "~/.local/state/sway-context/contexts.json"))
  LOG_PATH    = File.expand_path(ENV.fetch("SWAY_CONTEXT_LOG", "~/.local/state/sway-context/launch.log"))

  # Append a line to the log file; with warn: true also print it to stderr.
  def self.log(message, warn: false)
    FileUtils.mkdir_p(File.dirname(LOG_PATH))
    File.open(LOG_PATH, "a") { |f| f.puts "#{Time.now.strftime('%F %T')} #{message}" }
    Kernel.warn "sway-context: #{message}" if warn
  end
  GROUP_SIZE  = 10 # swaysome: workspace number = output_group * 10 + slot

  DEFAULT_CONFIG = {
    # Outputs that do not take part in contexts. Outputs are indexed by
    # position, left to right, starting at 0; -1 is the rightmost one.
    # Sway output names (strings) are accepted as well.
    "ambient_outputs" => [0],
    # Actions: named commands that can be run in a context (`sway-context run`).
    #   "launch"      argv; every argument may use placeholders (see below)
    #   "output"      position index of the output to open the window on;
    #                 default: the focused output
    #   "layout"      sway layout to set on the target workspace first
    #   "window"      false for commands that open no window: they are run
    #                 synchronously instead of waiting for a window to place
    #   "env"         extra environment for this action
    #   "description" shown in the run menu
    # Placeholders: {name} context name, {slot} slot number, {rest} name after
    # the project match, {1}..{9} capture groups, {dir} project directory, and
    # every key of the project's "vars". Unknown {…} are left untouched; a
    # leading ~ is expanded.
    #   "terminal" => { "launch" => ["kitty"] },
    #   "editor"   => { "launch" => ["zed", "{dir}"], "output" => 1 }
    "actions" => {},
    # Projects: the first whose "match" regexp matches the context name wins.
    #   "name"      for display and for "extends"
    #   "extends"   name of another project whose settings this one refines
    #   "vars"      placeholder values (may use built-in placeholders)
    #   "env"       environment exported to everything launched in the context
    #   "dir"       working directory: a path template, or an argv whose
    #               stdout is the path. If it cannot be resolved, "setup" is
    #               run once and the lookup retried.
    #   "setup"     action name or argv that creates the directory
    #   "on_create" action names to run when a context is created
    #   "actions"   project-specific actions (override global ones)
    "projects" => [],
    # Seconds to wait for a launched application's window before giving up
    # on placing it.
    "launch_timeout" => 15,
    # Shell files to source before running commands. Sway's exec environment
    # lacks variables your shell sets up (e.g. SSH_AUTH_SOCK), so list the
    # files that provide them. $VARS and ~ are expanded; missing files are
    # skipped.
    #   ["$XDG_RUNTIME_DIR/ssh-agent.env"]
    "launch_env_files" => [],
    # Command used for menus and prompts. Must read choices on stdin and
    # print the chosen (or typed) line on stdout, like rofi -dmenu.
    "menu" => ["rofi", "-dmenu", "-i"],
    # Slots handed out to new contexts, in order of preference.
    "slots" => [1, 2, 3, 4, 5, 6, 7, 8, 9, 0],
  }.freeze

  class Error < StandardError; end

  # Thin wrapper around swaymsg.
  class Sway
    def run(command)
      out, err, status = Open3.capture3("swaymsg", command)
      raise Error, "swaymsg #{command.inspect} failed: #{err.strip} #{out.strip}" unless status.success?
      results = JSON.parse(out) rescue []
      failed = results.find { |r| r["success"] == false }
      raise Error, "swaymsg #{command.inspect}: #{failed["error"]}" if failed
      out
    end

    def get(type)
      out, err, status = Open3.capture3("swaymsg", "-t", "get_#{type}")
      raise Error, "swaymsg -t get_#{type} failed: #{err.strip}" unless status.success?
      JSON.parse(out)
    end

    def outputs    = get(:outputs).select { |o| o["active"] }
    def workspaces = get(:workspaces)
    def tree       = get(:tree)

    # Window container ids per workspace num, derived from the tree.
    def windows_by_workspace
      windows = Hash.new { |h, k| h[k] = [] }
      walk = lambda do |node, ws_num|
        ws_num = node["num"] if node["type"] == "workspace"
        children = node.fetch("nodes", []) + node.fetch("floating_nodes", [])
        if children.empty? && ws_num && %w[con floating_con].include?(node["type"])
          windows[ws_num] << node["id"]
        end
        children.each { |c| walk.call(c, ws_num) }
      end
      walk.call(tree, nil)
      windows
    end
  end

  # Starts applications and moves the window each one opens to a target
  # workspace, by listening to sway's window events. Launching one at a time
  # and moving the window explicitly makes placement independent of which
  # workspace happens to be focused when the app finally maps its window.
  class Launcher
    def initialize(sway, timeout:)
      @sway = sway
      @timeout = timeout
      @events, @thread = nil
    end

    # Programs' stdout/stderr go to the log file so failures are visible even
    # when started from a keybinding.
    def launch(argv, target_num, env: {}, chdir: nil)
      subscribe
      drain
      SwayContext.log("launch (-> workspace #{target_num}#{chdir ? ", in #{chdir}" : ''}): #{argv.join(' ')}")
      opts = { in: File::NULL, pgroup: true }
      opts[:chdir] = chdir if chdir
      log = File.open(LOG_PATH, "a")
      pid = Process.spawn(env, *argv, out: log, err: log, **opts)
      log.close
      Process.detach(pid)
      if (event = wait_for_new_window)
        id = event["container"]["id"]
        @sway.run("[con_id=#{id}] move container to workspace number #{target_num}")
      else
        SwayContext.log("no window appeared within #{@timeout}s for #{argv.join(' ')}; leaving it where it opens", warn: true)
      end
    end

    def close
      Process.kill("TERM", @thread.pid) if @thread&.alive?
      @events&.close
    rescue Errno::ESRCH, IOError
      nil
    end

    private

    def subscribe
      return if @events
      _stdin, @events, @thread = Open3.popen2("swaymsg", "-r", "-t", "subscribe", "-m", '["window"]')
      _stdin.close
    end

    # Discard events that arrived before the launch (e.g. from earlier apps).
    def drain
      @events.read_nonblock(1 << 16) while IO.select([@events], nil, nil, 0)
    rescue IO::WaitReadable, EOFError
      nil
    end

    def wait_for_new_window
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + @timeout
      loop do
        remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
        return nil if remaining <= 0 || !IO.select([@events], nil, nil, remaining)
        line = @events.gets or return nil
        event = JSON.parse(line) rescue next
        return event if event["change"] == "new"
      end
    end
  end

  # position: index among active outputs sorted left to right (0-based).
  Output = Struct.new(:name, :group, :focused, :current_num, :position, keyword_init: true)
  Workspace = Struct.new(:num, :name, :output, :visible, :focused, keyword_init: true) do
    def slot = num % GROUP_SIZE
    def group = num / GROUP_SIZE
    # The part after the first colon, if any.
    def context_name
      name.split(":", 2)[1]
    end
  end

  # A context (name + slot) seen through its project: placeholder values,
  # environment, directory and available actions.
  class Scope
    PLACEHOLDER = /\{([A-Za-z_]\w*|\d)\}/

    attr_reader :manager, :name, :slot, :project, :match

    # dry_run: never run setup (for `show`).
    def initialize(manager, name:, slot:, dry_run: false)
      @manager = manager
      @name = name
      @slot = slot
      @dry_run = dry_run
      @project, @match = manager.project_for(name) if name
    end

    def project_label = project && (project["name"] || project["match"])

    # {name}, {slot}, {rest}, {1}..{9}
    def builtins
      v = { "name" => name.to_s, "slot" => slot.to_s }
      if match
        v["rest"] = name[match.end(0)..]
        match.captures.each_with_index { |c, i| v[(i + 1).to_s] = c.to_s }
      end
      v
    end

    # Built-ins plus the project's vars; a var may use earlier vars.
    def vars
      @vars ||= (project&.fetch("vars", nil) || {}).each_with_object(builtins) do |(k, v), table|
        table[k] = expand(v.to_s, table)
      end
    end

    # Replace known {placeholders}; unknown ones stay. Expands a leading ~.
    def expand(str, table = vars_with_dir(str))
      out = str.gsub(PLACEHOLDER) { |m| table.key?($1) ? table[$1] : m }
      out.start_with?("~/") || out == "~" ? File.expand_path(out) : out
    end

    # Like expand, but fails if {dir} is needed and cannot be resolved.
    def expand!(str)
      out = expand(str)
      raise Error, "#{str.inspect} needs {dir}, but #{dir_problem}" if out.include?("{dir}")
      out
    end

    # Only look up the directory when a string actually asks for it.
    def vars_with_dir(str)
      str.include?("{dir}") && (d = dir) ? vars.merge("dir" => d) : vars
    end

    def dir_problem
      return "the current slot has no context" unless name
      return "no project matches #{name.inspect}" unless project
      return "project #{project_label} defines no dir" unless project["dir"]
      "the dir of project #{project_label} could not be resolved (see log)"
    end

    # Environment exported to everything launched in this context.
    def env
      e = { "SWAY_CONTEXT" => name.to_s, "SWAY_CONTEXT_SLOT" => slot.to_s }
      (project&.fetch("env", nil) || {}).each { |k, v| e[k] = expand(v.to_s) }
      e["SWAY_CONTEXT_DIR"] = dir if dir
      e
    end

    # Full process environment: sourced env files, then context env, then extra.
    def process_env(extra = {}) = manager.launch_env.merge(env).merge(extra)

    def actions
      @actions ||= manager.config.fetch("actions", {}).merge(project&.fetch("actions", nil) || {})
    end

    # Resolved project directory, running "setup" once if it is missing.
    def dir
      return @dir if defined?(@dir)
      @dir = nil
      return nil unless project && project["dir"]
      @dir = lookup_dir
      if @dir.nil? && project["setup"] && !@dry_run
        SwayContext.log("dir for #{name} not found, running setup")
        manager.run_setup(self)
        @dir = lookup_dir
      end
      SwayContext.log("could not resolve dir for #{name} (project #{project_label})", warn: !@dry_run) if @dir.nil?
      @dir
    end

    # Try the "dir" spec once, without side effects. nil if not found.
    def lookup_dir
      spec = project["dir"]
      path =
        if spec.is_a?(Array)
          argv = spec.map { |a| expand(a, vars) }
          out, err, status = Open3.capture3(process_env_without_dir, *argv)
          SwayContext.log("dir command failed: #{argv.join(' ')}: #{err.strip}") unless status.success?
          status.success? ? out.strip : ""
        else
          expand(spec, vars)
        end
      return nil if path.empty?
      path = File.expand_path(path)
      File.directory?(path) ? path : nil
    end

    private

    def process_env_without_dir
      manager.launch_env.merge("SWAY_CONTEXT" => name.to_s, "SWAY_CONTEXT_SLOT" => slot.to_s)
    end
  end

  class Manager
    attr_reader :config, :sway

    def initialize(sway: Sway.new, config: load_config)
      @sway = sway
      @config = config
      warn "sway-context: config key \"templates\" is no longer supported; use \"projects\" and \"actions\" (see README)" if config.key?("templates")
    end

    # ----- model -------------------------------------------------------------

    def load_config
      return DEFAULT_CONFIG.dup unless File.exist?(CONFIG_PATH)
      DEFAULT_CONFIG.merge(JSON.parse(File.read(CONFIG_PATH)))
    end

    def workspaces
      @workspaces ||= sway.workspaces.map do |w|
        Workspace.new(num: w["num"], name: w["name"], output: w["output"],
                      visible: w["visible"], focused: w["focused"])
      end
    end

    # All active outputs, sorted left to right (then top to bottom).
    def outputs
      @outputs ||= sway.outputs
        .sort_by { |o| [o["rect"]["x"], o["rect"]["y"]] }
        .each_with_index.map do |o, i|
          current = workspaces.find { |w| w.name == o["current_workspace"] }
          Output.new(name: o["name"], focused: o["focused"], position: i,
                     current_num: current&.num, group: current&.group)
        end
    end

    # Output by position index; negative counts from the right.
    def output_at(index) = outputs[index]

    def ambient?(output)
      config["ambient_outputs"].any? do |spec|
        spec.is_a?(Integer) ? output_at(spec)&.name == output.name : spec == output.name
      end
    end

    def work_outputs
      outs = outputs.reject { |o| ambient?(o) || o.group.nil? }.sort_by(&:group)
      raise Error, "no work outputs found (all outputs are ambient or have no numbered workspace)" if outs.empty?
      outs
    end

    def work_groups = work_outputs.map(&:group)

    def work_workspaces(slot) = workspaces.select { |w| w.slot == slot && work_groups.include?(w.group) }

    # The focused output if it is a work output, else the first work output.
    def focused_work_output
      focused = outputs.find(&:focused)
      focused && !ambient?(focused) ? focused : work_outputs.first
    end

    # slot => name. Live workspace names win over the state file.
    def contexts
      @contexts ||= begin
        ctx = load_state
        work_workspaces_all = workspaces.select { |w| work_groups.include?(w.group) }
        work_workspaces_all.each do |w|
          name = w.context_name
          ctx[w.slot] = name if name && !name.empty?
        end
        # Forget names whose workspaces exist but are all unnamed (renamed away manually).
        ctx.delete_if do |slot, _|
          wss = work_workspaces(slot)
          !wss.empty? && wss.none?(&:context_name)
        end
        ctx
      end
    end

    def context_by_name(name) = contexts.find { |_, n| n == name }&.first

    def windows_by_workspace
      @windows ||= sway.windows_by_workspace
    end

    def window_count(slot)
      work_workspaces(slot).sum { |w| windows_by_workspace[w.num].size }
    end

    def current_slot = focused_work_output.current_num % GROUP_SIZE

    def free_slot
      config["slots"].find { |s| !contexts.key?(s) && work_workspaces(s).empty? } ||
        raise(Error, "no free slot: all #{config["slots"].size} slots are in use")
    end

    def scope_for(slot, name = contexts[slot]) = Scope.new(self, name: name, slot: slot)

    def current_scope = scope_for(current_slot)

    # ----- state file --------------------------------------------------------

    def load_state
      return {} unless File.exist?(STATE_PATH)
      JSON.parse(File.read(STATE_PATH)).to_h { |k, v| [Integer(k), v] }
    rescue JSON::ParserError, ArgumentError
      {}
    end

    def save_state
      FileUtils.mkdir_p(File.dirname(STATE_PATH))
      File.write(STATE_PATH, JSON.pretty_generate(contexts.sort.to_h) + "\n")
    end

    # ----- sway actions -----------------------------------------------------

    def label(num, name) = name ? "#{num}:#{name}" : num.to_s

    # Rename the existing workspaces of a slot (does not create or focus anything).
    def apply_names(slot, name)
      work_workspaces(slot).each do |w|
        target = label(w.num, name)
        next if w.name == target
        sway.run(%(rename workspace "#{w.name}" to "#{target}"))
        w.name = target
      end
    end

    # Show slot on every work output, creating and naming workspaces as needed.
    def focus_slot(slot, name)
      before = outputs.find(&:focused)
      work_outputs.each do |out|
        num = out.group * GROUP_SIZE + slot
        existing = workspaces.find { |w| w.num == num }
        if existing && existing.output != out.name
          # Stray workspace on the wrong output (e.g. after re-plugging monitors).
          sway.run("workspace number #{num}")
          sway.run("move workspace to output #{out.name}")
        end
        sway.run("focus output #{out.name}")
        sway.run("workspace number #{num}")
      end
      refresh!
      apply_names(slot, name)
      # Land where the user was, unless that was the ambient output.
      back_to = before && !ambient?(before) ? before : work_outputs.first
      sway.run("focus output #{back_to.name}")
    end

    def kill_windows(slot)
      work_workspaces(slot).each do |w|
        sway.run(%([workspace="^#{Regexp.escape(w.name)}$"] kill))
      end
    end

    def refresh!
      @workspaces = @outputs = @windows = nil
    end

    # ----- projects and actions ----------------------------------------------

    # Projects with "extends" resolved: hashes (vars, env, actions) are merged,
    # everything else is overridden by the extending project.
    def projects
      @projects ||= begin
        raw = config.fetch("projects", [])
        by_name = raw.to_h { |p| [p["name"], p] }
        resolve = lambda do |p, seen = []|
          base = p["extends"] or return p
          raise Error, "project #{p["name"] || p["match"]}: extends unknown project #{base.inspect}" unless by_name[base]
          raise Error, "project #{base}: circular extends" if seen.include?(base)
          merged = resolve.call(by_name[base], seen + [base]).merge(p.reject { |k, _| k == "extends" })
          %w[vars env actions].each do |k|
            merged[k] = (by_name[base][k] || {}).merge(p[k] || {}) if by_name[base][k] || p[k]
          end
          merged
        end
        raw.map { |p| resolve.call(p) }
      end
    end

    # [project, match_data] for the first project matching the name, or nil.
    def project_for(name)
      projects.each do |p|
        next unless p["match"]
        m = Regexp.new(p["match"]).match(name)
        return [p, m] if m
      end
      nil
    end

    # Environment variables gained by sourcing config["launch_env_files"] in sh.
    def launch_env
      @launch_env ||= config["launch_env_files"].each_with_object({}) do |file, env|
        path = File.expand_path(file.gsub(/\$(\w+)/) { ENV[$1].to_s })
        next SwayContext.log("env file #{path} not found, skipping", warn: true) unless File.exist?(path)
        out, status = Open3.capture2("sh", "-c", '. "$1" >/dev/null 2>&1; env -0', "sh", path)
        next SwayContext.log("sourcing #{path} failed", warn: true) unless status.success?
        out.split("\0").each do |kv|
          k, v = kv.split("=", 2)
          env[k] = v if v && ENV[k] != v && !%w[PWD OLDPWD SHLVL _].include?(k)
        end
      end
    end

    def action_for(scope, key)
      action = scope.actions[key]
      return action if action.is_a?(Hash) && action["launch"].is_a?(Array)
      where = scope.project ? " (project #{scope.project_label})" : ""
      raise Error, "no action #{key.inspect}#{where}; available: #{scope.actions.keys.sort.join(', ')}"
    end

    def action_argv(scope, action) = action["launch"].map { |a| scope.expand!(a.to_s) }

    def action_env(scope, action) = scope.process_env(action.fetch("env", {}).transform_values { |v| scope.expand!(v.to_s) })

    # Run an action in the scope's context. Window-opening actions go through
    # the launcher; "window": false actions run synchronously, logged.
    def run_action(scope, key, launcher:)
      action = action_for(scope, key)
      argv = action_argv(scope, action)
      env = action_env(scope, action)
      return run_sync(argv, env, chdir: scope.dir, what: "action #{key}") if action["window"] == false

      out = target_output(action["output"], key)
      num = out.group * GROUP_SIZE + scope.slot
      if (layout = action["layout"])
        focused = outputs.find(&:focused)
        sway.run("focus output #{out.name}")
        sway.run("workspace number #{num}")
        sway.run("layout #{layout}")
        sway.run("focus output #{focused.name}") if focused
      end
      launcher.launch(argv, num, env: env, chdir: scope.dir)
    end

    # The output an action opens on: its "output" index if connected and not
    # ambient, else the focused work output.
    def target_output(index, key)
      return focused_work_output if index.nil?
      out = output_at(Integer(index))
      return out if out && !ambient?(out)
      warn "sway-context: output #{index} for action #{key} is #{out ? 'ambient' : 'not connected'}, using the focused output"
      focused_work_output
    end

    # Run argv to completion with stdout/stderr in the log; warn on failure.
    def run_sync(argv, env, chdir: nil, what: argv.first)
      SwayContext.log("run#{chdir ? " (in #{chdir})" : ''}: #{argv.join(' ')}")
      opts = { in: File::NULL }
      opts[:chdir] = chdir if chdir
      log = File.open(LOG_PATH, "a")
      pid = Process.spawn(env, *argv, out: log, err: log, **opts)
      log.close
      _, status = Process.wait2(pid)
      SwayContext.log("#{what} failed with status #{status.exitstatus} (see #{LOG_PATH})", warn: true) unless status.success?
      status.success?
    end

    # The project's "setup": an action name (run without a window) or an argv.
    # {dir} is not available here, since setup is what creates it.
    def run_setup(scope)
      spec = scope.project["setup"]
      argv, extra_env, what =
        if spec.is_a?(Array)
          [spec, {}, "setup"]
        else
          action = action_for(scope, spec.to_s)
          [action["launch"], action.fetch("env", {}), "setup (#{spec})"]
        end
      argv = argv.map { |a| scope.expand(a.to_s, scope.vars) }
      env = scope.process_env(extra_env.transform_values { |v| scope.expand(v.to_s, scope.vars) })
      run_sync(argv, env, what: what)
    end

    # Bring a freshly created context to life: resolve its directory (which
    # runs setup if needed) and run the project's on_create actions. Assumes
    # focus_slot has just shown the slot on every work output.
    def run_on_create(scope)
      return unless scope.project
      if scope.project["dir"]
        scope.dir # runs setup when the directory is missing
      elsif scope.project["setup"]
        run_setup(scope)
      end
      launcher = Launcher.new(sway, timeout: config["launch_timeout"])
      scope.project.fetch("on_create", []).each { |key| run_action(scope, key, launcher: launcher) }
    ensure
      launcher&.close
    end

    # Drop contexts that have no windows left (except slots listed in `keep`).
    def prune_empty(keep: [])
      contexts.keys.each do |slot|
        next if keep.include?(slot) || window_count(slot) > 0
        contexts.delete(slot)
        apply_names(slot, nil)
        warn "dropped empty context in slot #{slot}"
      end
    end

    # ----- menu --------------------------------------------------------------

    def menu(lines, prompt:, filter: nil)
      cmd = config["menu"] + ["-p", prompt]
      cmd += ["-filter", filter] if filter
      out, status = Open3.capture2(*cmd, stdin_data: lines.join("\n"))
      choice = out.strip
      return nil if !status.success? && choice.empty?
      choice.empty? ? nil : choice
    end

    def menu_line(slot, name)
      count = window_count(slot)
      format("%d  %-30s %s", slot, name, count == 1 ? "1 window" : "#{count} windows")
    end

    def validate_name!(name)
      name = name.to_s.strip.tr('"', "'").gsub(/\s+/, " ")
      raise Error, "context name must not be empty" if name.empty?
      raise Error, "context name must not start with a digit or colon" if name.match?(/\A[\d:]/)
      name
    end

    # ----- commands ----------------------------------------------------------

    def cmd_list
      slots = (contexts.keys | workspaces.select { |w| work_groups.include?(w.group) }.map(&:slot)).sort
      cur = current_slot
      slots.each do |slot|
        marker = slot == cur ? "*" : " "
        name = contexts[slot] || "(unnamed)"
        puts format("%s %d  %-30s %2d windows  [%s]", marker, slot, name, window_count(slot),
                    work_workspaces(slot).map(&:name).join(", "))
      end
      save_state
    end

    def cmd_current
      puts contexts[current_slot].to_s
    end

    def cmd_switch(name = nil)
      from = current_slot
      # Contexts without windows are meaningless; drop them before offering them.
      # The current slot is kept until we have actually left it.
      prune_empty(keep: [from])
      if name.nil?
        lines = contexts.sort.map { |slot, n| menu_line(slot, n) }
        choice = menu(lines, prompt: "context")
        return if choice.nil?
        idx = lines.index(choice)
        if idx
          slot = contexts.sort[idx].first
        elsif (slot = context_by_name(choice.strip))
          # typed an exact existing name
        else
          return cmd_new(choice)
        end
      else
        slot = context_by_name(name) or raise Error, "no context named #{name.inspect}"
      end
      focus_slot(slot, contexts[slot])
      prune_empty(keep: [slot]) if from != slot
      save_state
    end

    # Cycle through contexts in slot order; direction is +1 or -1.
    def cmd_cycle(direction)
      from = current_slot
      prune_empty(keep: [from])
      slots = contexts.keys.sort
      others = slots - [from]
      return warn("sway-context: no other context to switch to") if others.empty?
      # Slots ahead of (or behind) the current one, wrapping around.
      ahead = direction > 0 ? others.select { |s| s > from } + others.select { |s| s < from }
                            : others.select { |s| s < from }.reverse + others.select { |s| s > from }.reverse
      slot = ahead.first
      focus_slot(slot, contexts[slot])
      prune_empty(keep: [slot])
      save_state
      puts "#{slot}  #{contexts[slot]}"
    end

    def cmd_new(name = nil)
      prune_empty(keep: [current_slot]) # frees slots held by stale contexts
      name ||= menu([], prompt: "new context") or return
      name = validate_name!(name)
      created = false
      if (slot = context_by_name(name))
        warn "context #{name.inspect} already exists in slot #{slot}, switching to it"
      else
        slot = free_slot
        contexts[slot] = name
        created = true
      end
      focus_slot(slot, name)
      prune_empty(keep: [slot])
      save_state
      puts "#{slot}  #{name}"
      run_on_create(scope_for(slot, name)) if created
    end

    # Name (or rename) the current slot. Whatever is on the slot's workspaces,
    # on any work output, becomes part of the context.
    def cmd_name(name = nil)
      slot = current_slot
      renaming = contexts.key?(slot)
      name ||= menu([], prompt: renaming ? "rename context" : "name context", filter: contexts[slot]) or return
      name = validate_name!(name)
      other = context_by_name(name)
      raise Error, "context #{name.inspect} already exists in slot #{other}" if other && other != slot
      contexts[slot] = name
      if renaming
        apply_names(slot, name)
      else
        # A fresh context: bring up and name the slot on every work output.
        focus_slot(slot, name)
      end
      save_state
      puts "#{slot}  #{name}"
      run_on_create(scope_for(slot, name)) unless renaming
    end

    def cmd_close(*args)
      kill = args.delete("--kill")
      name = args.first
      slot = name ? (context_by_name(name) or raise Error, "no context named #{name.inspect}") : current_slot
      raise Error, "slot #{slot} has no context" unless contexts.key?(slot)
      if kill
        kill_windows(slot)
        sleep 0.2 # give clients a moment to go away before we rename
        refresh!
      elsif window_count(slot) > 0
        warn "note: #{window_count(slot)} windows remain in slot #{slot} (use --kill to close them)"
      end
      contexts.delete(slot)
      apply_names(slot, nil)
      save_state
    end

    # Re-apply stored names to live workspaces, e.g. after a sway restart.
    def cmd_sync
      contexts.each { |slot, name| apply_names(slot, name) }
      save_state
    end

    # Run an action in the current context; without a key, offer a menu.
    def cmd_run(key = nil)
      scope = current_scope
      keys = scope.actions.keys.sort
      raise Error, "no actions configured" if keys.empty?
      if key.nil?
        lines = keys.map { |k| format("%-14s %s", k, scope.actions[k]["description"].to_s).rstrip }
        choice = menu(lines, prompt: scope.name || "run") or return
        key = lines.index(choice) ? keys[lines.index(choice)] : choice.strip
      end
      launcher = Launcher.new(sway, timeout: config["launch_timeout"])
      run_action(scope, key, launcher: launcher)
    ensure
      launcher&.close
    end

    # Print the current context's environment for `eval` in a shell.
    def cmd_env(*flags)
      env = current_scope.env
      env.each do |k, v|
        puts flags.include?("--fish") ? "set -gx #{k} #{Shellwords.escape(v)}" : "export #{k}=#{Shellwords.escape(v)}"
      end
    end

    def cmd_dir
      scope = current_scope
      puts(scope.dir || raise(Error, scope.dir_problem))
    end

    # Show how a context name resolves: project, vars, env, dir and actions. Dry run.
    def cmd_show(name = nil)
      slot = name ? context_by_name(name) : current_slot
      name ||= contexts[slot] or raise Error, "the current slot has no context; pass a name"
      scope = Scope.new(self, name: name, slot: slot || 0, dry_run: true)
      puts "context: #{name}  slot: #{slot || '(none, assuming 0)'}"
      if scope.project
        puts "project: #{scope.project_label}  match: #{scope.project["match"]}"
        scope.vars.each { |k, v| puts "  {#{k}} = #{v}" }
        spec = scope.project["dir"]
        dir = spec && scope.lookup_dir
        puts "dir: #{spec.is_a?(Array) ? spec.join(' ') : spec} -> #{dir || "not found#{scope.project["setup"] ? ', would run setup' : ''}"}" if spec
        puts "on_create: #{scope.project.fetch("on_create", []).join(', ')}"
      else
        puts "project: none"
      end
      env = scope.env
      puts "env: #{env.map { |k, v| "#{k}=#{v}" }.join(' ')}"
      puts "actions:"
      scope.actions.sort.each do |key, action|
        argv = action["launch"].map { |a| scope.expand(a.to_s) }
        where = action["window"] == false ? "no window" : "output #{action["output"] || 'focused'}"
        puts format("  %-14s %s  [%s]", key, argv.join(" "), where)
      end
      puts "env files #{config["launch_env_files"].inspect}: #{launch_env.keys.join(', ')}" unless launch_env.empty?
    end
  end

  USAGE = <<~TXT
    usage: sway-context <command> [args]

      switch [name]     menu of contexts; pick one or type a new name to create it
      new [name]        create a context in a free slot and switch to it
      next / prev       cycle through contexts in slot order
      name [name]       name the current slot as a new context (switching all work outputs to it),
                        or rename an existing one (aliases: rename, adopt)
      close [name] [--kill]
                        forget a context; with --kill also close its windows
      run [action]      run an action in the current context; without an action, show a menu
      env [--fish]      print the current context's environment for eval
      dir               print the current context's project directory
      show [name]       show project, vars, env, dir and actions for a context (dry run)
      list              show slots, names and window counts
      current           print the current context name (for bars)
      sync              re-apply stored names to workspaces (after sway restart)

    config: #{CONFIG_PATH}
    state:  #{STATE_PATH}
    log:    #{LOG_PATH}
  TXT

  def self.main(argv)
    cmd, *args = argv
    m = Manager.new
    case cmd
    when "switch"  then m.cmd_switch(*args)
    when "new"     then m.cmd_new(*args)
    when "name", "rename", "adopt" then m.cmd_name(*args)
    when "close"   then m.cmd_close(*args)
    when "run"     then m.cmd_run(*args)
    when "env"     then m.cmd_env(*args)
    when "dir"     then m.cmd_dir
    when "show", "template" then m.cmd_show(*args)
    when "list"    then m.cmd_list
    when "next"    then m.cmd_cycle(1)
    when "prev"    then m.cmd_cycle(-1)
    when "current" then m.cmd_current
    when "sync"    then m.cmd_sync
    when nil, "-h", "--help", "help" then puts USAGE
    else
      warn "unknown command #{cmd.inspect}\n\n#{USAGE}"
      exit 2
    end
  rescue Error => e
    warn "sway-context: #{e.message}"
    exit 1
  end
end

SwayContext.main(ARGV) if $PROGRAM_NAME == __FILE__
