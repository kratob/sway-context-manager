{
  "ambient_outputs": [
    0
  ],
  "menu": [
    "rofi",
    "-dmenu",
    "-i"
  ],
  "slots": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9,
    0
  ],
  "launch_timeout": 15,
  "launch_env_files": [
    "$XDG_RUNTIME_DIR/ssh-agent.env"
  ],
  "actions": {
    "terminal": {
      "description": "terminal in the project directory",
      "launch": [
        "kitty"
      ]
    },
    "editor": {
      "description": "editor on the project directory",
      "launch": [
        "zed",
        "{dir}"
      ],
      "output": 1
    },
    "tracker": {
      "description": "issue tracker in the browser",
      "launch": [
        "google-chrome",
        "--new-window",
        "{issue_url}"
      ],
      "output": -1
    },
    "worktree": {
      "description": "create the worktree branch if needed",
      "window": false,
      "launch": [
        "sh",
        "-c",
        "cd {repo} && B={branch} && if git show-ref --verify -q \"refs/heads/$B\"; then wt switch -y \"$B\"; else wt switch -y -c \"$B\" -b origin/master; fi"
      ],
      "hidden": true
    },
    "mr": {
      "description": "merge request for the branch, or the project if there is none",
      "output": -1,
      "launch": [
        "sh",
        "-c",
        "URL=$(glab mr view \"$1\" -F json 2>/dev/null | jq -r .web_url); [ -n \"$URL\" ] || URL=$(glab repo view -F json 2>/dev/null | jq -r .web_url); exec google-chrome --new-window \"$URL\"",
        "sh",
        "{branch}"
      ]
    },
    "worktree-remove": {
      "description": "remove the worktree (fails if it has uncommitted changes)",
      "window": false,
      "launch": [
        "sh",
        "-c",
        "cd {repo} && wt remove -y --foreground {branch}"
      ],
      "hidden": true
    },
    "kill": {
      "description": "close all windows of this context and forget it",
      "window": false,
      "launch": [
        "~/bin/sway-context",
        "kill",
        "{name}"
      ]
    }
  },
  "projects": [
    {
      "name": "proj-issue",
      "extends": "proj",
      "match": "^proj-(\\d+)$",
      "vars": {
        "issue_url": "https://tracker.example.com/issue/{1}"
      }
    },
    {
      "name": "proj",
      "match": "^proj-",
      "vars": {
        "repo": "~/src/myproject",
        "branch": "me/{name}",
        "issue_url": "https://tracker.example.com/board"
      },
      "env": {
        "TEST_ENV_NUMBER": "{slot}",
        "PORT": "300{slot}"
      },
      "dir": [
        "sh",
        "-c",
        "git -C {repo} worktree list --porcelain | grep -B2 -x \"branch refs/heads/{branch}\" | sed -n 's/^worktree //p'"
      ],
      "setup": "worktree",
      "on_create": [
        "editor",
        "tracker"
      ],
      "teardown": "worktree-remove"
    }
  ]
}
