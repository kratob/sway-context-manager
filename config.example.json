{
  "ambient_outputs": [
    0
  ],
  "menu": [
    "rofi",
    "-dmenu",
    "-i"
  ],
  "slots": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9,
    0
  ],
  "launch_timeout": 15,
  "templates": [
    {
      "match": "^proj-(\\d+)$",
      "outputs": {
        "1": {
          "launch": [
            [
              "sh",
              "-c",
              "cd ~/src/myproject && git fetch -q origin master && { wt switch -y -c {name} -b origin/master -x zed -- \"{{ worktree_path }}\" || wt switch -y {name} -x zed -- \"{{ worktree_path }}\"; }"
            ]
          ]
        },
        "-1": {
          "launch": [
            [
              "google-chrome",
              "--new-window",
              "https://tracker.example.com/issues/PROJ-{1}"
            ]
          ]
        }
      }
    },
    {
      "match": "^proj-",
      "outputs": {
        "1": {
          "launch": [
            [
              "sh",
              "-c",
              "cd ~/src/myproject && git fetch -q origin master && { wt switch -y -c {name} -b origin/master -x zed -- \"{{ worktree_path }}\" || wt switch -y {name} -x zed -- \"{{ worktree_path }}\"; }"
            ]
          ]
        },
        "-1": {
          "launch": [
            [
              "google-chrome",
              "--new-window",
              "https://tracker.example.com/projects/PROJ"
            ]
          ]
        }
      }
    }
  ],
  "launch_env_files": [
    "$XDG_RUNTIME_DIR/ssh-agent.env"
  ]
}
